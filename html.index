announcements and updates
from Jayy Valley.

</p>


<form
class="form"
id="joinForm"
>


<input
id="email"
type="email"
placeholder="your@email.com"
required
>


<button type="submit">
JOIN
</button>


</form>


<div
class="form-message"
id="formMessage"
></div>


